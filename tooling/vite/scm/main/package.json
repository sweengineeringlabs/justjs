{
  "name": "@justjs/vite",
  "version": "0.1.0",
  "description": "JustJS Vite plugin — config codegen + HMR",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/saf/index.js",
      "types": "./dist/saf/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun ../../../../scripts/ci/check-tooling-layers.ts && tsc --build tsconfig.json",
    "typecheck": "tsc --build tsconfig.json",
    "test": "bun test",
    "dev": "bun run src/saf/codegen.ts"
  },
  "dependencies": {
    "@justjs/application": "^0.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^20.10.0",
    "bun-types": "^1.4.2",
    "typescript": "^5.5.0"
  },
  "justjsLayers": {
    "core": [
      "src/core/**/*.ts"
    ],
    "spi": [
      "src/spi/**/*.ts"
    ],
    "api": [
      "src/api/**/*.ts"
    ]
  }
}
