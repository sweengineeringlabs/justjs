    "dashboard": {
      "id": "agentic-memory-demo:app:shell:dashboard",
      "selector": "#mount-dashboard"
    },
    "mount": {
      "id": "agentic-memory-demo:app:shell:mount",
      "selector": "#app"
    }
  },
  "schema": "1",
  "version": "0.1.0"
}